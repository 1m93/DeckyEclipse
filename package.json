{
  "name": "decky-eclipse",
  "version": "0.2.0",
  "description": "Moonlight & Sunshine game streaming control for SteamOS Gaming Mode.",
  "type": "module",
  "private": true,
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests",
    "package": "bash scripts/package.sh",
    "deploy": "bash scripts/deploy.sh",
    "native": "bash scripts/build-native.sh"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.16.0",
    "react-icons": "^5.7.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "rollup": "^4.64.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.1.2",
  "repository": "github:1m93/DeckyEclipse"
}
